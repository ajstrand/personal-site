    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/preact": "3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@preact/preset-vite": "^2.10.6",
    "preact-render-to-string": "6.7.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
