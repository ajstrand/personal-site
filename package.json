{
  "name": "my-personal-site",
  "version": "1.0.0",
  "main": "index.js",
  "author": "alex strand <ajstrand@gmail.com> (@_alex_strand)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [],
  "scripts": {
    "client": "vite",
    "dev": "node server.js",
    "b": "vite build",
    "site": "serve dist/static",
    "preview": "vite preview",
    "lint": "oxlint src",
    "lint:mdx": "eslint . --ext md,mdx",
    "test": "vitest",
    "prerender": "node --experimental-specifier-resolution=node prerender",
    "build": "npm run build:clientAssets && npm run build:server && npm run prerender && node copyFiles.js",
    "build:clientAssets": "vite build --outDir dist/static",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server.jsx"
  },
  "dependencies": {
    "preact": "10.29.2",
    "prop-types": "15.8.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.2",
    "@babel/preset-react": "7.28.5",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/preact": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@preact/preset-vite": "2.10.5",
    "@shikijs/rehype": "4.0.2",
    "@sindresorhus/slugify": "2.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.1",
    "consola": "3.4.2",
    "dayjs": "1.11.13",
    "eslint": "^9.35.0",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-oxlint": "^1.67.0",
    "eslint-plugin-testing-library": "7.16.0",
    "express": "4.21.2",
    "fs-extra": "^11.3.0",
    "graphql": "16.14.1",
    "graphql-request": "^7.1.2",
    "graphql-yoga": "5.18.0",
    "jsdom": "29.1.1",
    "lightningcss": "1.32.0",
    "msw": "2.14.6",
    "oxlint": "1.68.0",
    "path": "0.12.7",
    "preact-render-to-string": "6.7.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-parse": "9.0.1",
    "rehype-slug": "6.0.0",
    "remark-math": "6.0.0",
    "rollup-plugin-esbuild": "6.2.1",
    "serve": "14.2.4",
    "trash-cli": "7.2.0",
    "vite": "7.3.1",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitest": "4.1.0"
  }
